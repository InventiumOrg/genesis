# ---------------------------------------------------------------------------
# Inventium MVP — one Next.js app, one Postgres database.
# Copy to .env.local for development; set the same keys in Vercel for deploys.
# ---------------------------------------------------------------------------

# Postgres. Locally this is your own server; on Vercel use a POOLED connection
# string (Neon's `-pooler` host or any PgBouncer), because each serverless
# instance opens its own connections.
DATABASE_URL=postgresql://user@localhost:5432/inventium

# The app serves its own API. Leave these as-is unless the data layer is split
# back out into separate services, in which case point them at the gateway.
NEXT_PUBLIC_BACKEND_API_URI=/api/v1
NEXT_PUBLIC_TRANSACTIONS_API_URI=/api/v1/transactions

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# LaunchDarkly — the browser evaluates flags, so this is the environment's
# client-side ID, not a server SDK key. Project settings > Environments >
# https://app.launchdarkly.com. Left unset, every flag reads its default and
# the app runs unflagged.
NEXT_PUBLIC_LAUNCHDARKLY_CLIENT_SIDE_ID=

# OpenTelemetry. Unset or true when no collector is running.
OTEL_SDK_DISABLED=true
